# ─── Optional: Notion OAuth ("Sign in with Notion") ───
# Not needed for normal use — the app works with an internal integration token pasted in the UI.
#
# Only set these if you have your own *public* Notion integration and want OAuth sign-in while
# developing (`npm run dev` reads this file). Redirect URI to register in Notion:
#   http://localhost:21549/callback
#
# NEVER commit real values. To embed them into a private build, see docs/RELEASING.md.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
