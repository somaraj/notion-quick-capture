{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "jsx": "preserve",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "types": [
            "vite/client"
        ]
    },
    "include": [
        "src/renderer/**/*.ts",
        "src/renderer/**/*.vue",
        "src/shared/**/*.ts",
        "src/renderer/env.d.ts"
    ]
}